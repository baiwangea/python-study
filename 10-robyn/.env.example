# PostgreSQL 数据库密码（用于 docker-compose）
POSTGRES_PASSWORD=your-secure-password-here

# 数据库连接 URL
# 同步连接（SQLAlchemy）
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/robyn_db
# 异步连接（asyncpg）
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@localhost:5432/robyn_db

# 应用配置
DEBUG=True
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 安全密钥（生产环境请使用强随机字符串）
SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING

# CORS 配置（生产环境建议设置为具体域名）
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_ORIGINS=*

# PostgreSQL 连接池配置
PG_MIN_SIZE=10
PG_MAX_SIZE=20
PG_COMMAND_TIMEOUT=60

# 数据库迁移
APPLY_MIGRATIONS=false

# Sentry 监控（可选）
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
